# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Firebase (server / Admin SDK) ───────────────────────────────────
# Local: run `npm run emulators` and use the emulator block below — no real
# project or keys needed. Production: Project settings → Service accounts →
# Generate new private key, then copy these three fields out of the JSON.
# Never commit the key file; it is full admin access to the project.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes; the app converts them back to newlines.
FIREBASE_PRIVATE_KEY=

# Emulator only — setting these points the Admin SDK at the local emulators.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199

# ── Firebase (browser / client SDK) ─────────────────────────────────
# Project settings → General → Your apps → Web app config. These are public
# identifiers, not secrets; Firestore rules deny all client access anyway.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Emulator only.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199

# ── Market data vendor ──────────────────────────────────────────────
# https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
# Sustained request rate. Starter tier ~4-5/s. Set below your plan's ceiling —
# vendors ban on burst, and a ban mid-run corrupts a nightly ingest.
FMP_REQUESTS_PER_SECOND=4

# ── Ingest tuning ───────────────────────────────────────────────────
INGEST_EXCHANGES=NASDAQ,NYSE
INGEST_YEARS=30
# Quarterly periods per company (feeds TTM). FMP free plan max is 5.
INGEST_QUARTERS=8
INGEST_PRICE_LOOKBACK_DAYS=7

# ── Auth ────────────────────────────────────────────────────────────
# Public base URL — checkout return/callback URLs and ops alert links.
APP_URL=http://localhost:3000
# Enable Google in Firebase console → Authentication → Sign-in method, then:
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
# Telegram Login Widget. Without this, Telegram sign-in fails closed —
# it never falls back to trusting the unsigned payload.
AUTH_TELEGRAM_BOT_TOKEN=

# ── Payments ────────────────────────────────────────────────────────
# 'manual' (offline, signed) or 'payway'.
PAYMENTS_PROVIDER=manual
# Signs manual-provider webhooks. No default exists — a fallback would ship a
# universally forgeable webhook. openssl rand -hex 32
PAYMENTS_MANUAL_SECRET=
# The manual provider refuses to run in production unless this is 'true'.
PAYMENTS_ALLOW_MANUAL=

PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh

# ── Ops ─────────────────────────────────────────────────────────────
# Bearer token for /api/cron/*. Vercel Cron sends it automatically once set as
# a project env var. Unset means those endpoints refuse every call (503) —
# they can burn vendor quota and rewrite the whole database, so they fail closed.
# openssl rand -hex 32
CRON_SECRET=
# /ops dashboard access is a Firebase custom claim, not an env var — grant it with
# `npm run dev:user -- --email=you@example.com --password=... --admin`.
# Alert channel. Falls back to AUTH_TELEGRAM_BOT_TOKEN when unset. Without a
# chat id, alerting is skipped and logged rather than failing the run.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
# Override only for a self-hosted Bot API server or a local test stub.
OPS_TELEGRAM_API_BASE=https://api.telegram.org
