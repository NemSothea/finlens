rules_version = '2';

// Deny every client read and write.
//
// finlens reads and writes Firestore only from the server, through the Admin
// SDK, which bypasses these rules. Ownership (users/{uid}/...) and entitlement
// (Pro-only portfolio) are enforced in server code, in one place. Opening any
// path here would create a second, unaudited way into the data — and the
// paywall would then have to be re-implemented in rules as well.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
